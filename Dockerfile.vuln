FROM node:24-bookworm-slim@sha256:8579e5fce559544b50072d05cc5d3b84b6a14d0989ae56c331d9e983a36a21f1 AS lucide-assets

ENV COREPACK_HOME=/tmp/corepack
WORKDIR /build

RUN corepack enable && corepack prepare pnpm@12.15.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY tools ./tools
RUN pnpm sync-icons

FROM golang:1.27.3-bookworm@sha256:972b4110ba0f47539a975c31e52c64765e1ff19f2d74469ae4a595c6676e80a5 AS go-toolchain

FROM ubuntu:resolute@sha256:19fcd1bf268f02b60aca3bd30bd8a6d9a11759a430e32921833e65f16d87348a

COPY --from=go-toolchain /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential ca-certificates libvips-dev=8.18.0-1build1 pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN go install golang.org/x/vuln/cmd/govulncheck@v1.8.0

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY --from=lucide-assets /build/internal/cdn/assets/lucide ./internal/cdn/assets/lucide

# Query the vulnerability database on every run, independently of build caching.
ENTRYPOINT ["/root/go/bin/govulncheck"]
CMD ["-show", "verbose", "./..."]
